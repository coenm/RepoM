<UserControl x:Class="RepoM.UI.Controls.QuickFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:RepoM.UI.ViewModels"
             xmlns:themes="clr-namespace:RepoM.UI.Themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance viewModels:QuickFilterBarViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <StackPanel Orientation="Horizontal">
        <Border x:Name="combineModeToggle"
                Margin="0,0,8,4"
                Padding="5,1,5,1"
                BorderThickness="1"
                CornerRadius="5"
                Cursor="Hand"
                MouseLeftButtonUp="CombineModeToggle_Click"
                ToolTip="{Binding CombineModeToolTip}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="{DynamicResource PreviewTagBackground}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CombineModeLabel}" Value="OR">
                            <Setter Property="Background" Value="{DynamicResource QuickFilterSelectedBackground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource QuickFilterSelectedBorder}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource QuickFilterHoverBackground}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CombineModeLabel}" Value="OR" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource QuickFilterSelectedHoverBackground}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding CombineModeLabel}"
                       FontFamily="Consolas"
                       FontSize="11"
                       FontWeight="Bold"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PreviewMutedForeground}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CombineModeLabel}" Value="OR">
                                <Setter Property="Foreground" Value="{DynamicResource PreviewForeground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <ItemsControl x:Name="quickFilterItemsControl"
                      ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel x:Name="qfDropWrapper"
                            Orientation="Horizontal"
                            Margin="0,0,6,0"
                            d:DataContext="{d:DesignInstance viewModels:QuickFilterViewModel, IsDesignTimeCreatable=False}"
                            AllowDrop="True"
                            Drop="QuickFilter_Drop"
                            DragOver="QuickFilter_DragOver"
                            DragLeave="QuickFilter_DragLeave">
                    <Border x:Name="dropPlaceholderLeft"
                            Margin="0,0,6,4"
                            Padding="6,2,6,2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource PreviewMenuBorder}"
                            CornerRadius="5"
                            Background="{DynamicResource PreviewTagBackground}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <TextBlock x:Name="dropPlaceholderLeftText"
                                   FontFamily="Consolas"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource PreviewMutedForeground}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="qfBorder"
                            Margin="0,0,0,4"
                            Padding="5,1,5,1"
                            BorderThickness="1"
                            CornerRadius="5"
                            Cursor="Hand"
                            MouseLeftButtonUp="QuickFilter_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PreviewTagBackground}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource QuickFilterSelectedBackground}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource QuickFilterSelectedBorder}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                            <Condition Binding="{Binding IsInverse}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource QuickFilterInverseBackground}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource QuickFilterInverseBorder}" />
                                    </MultiDataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource QuickFilterHoverBackground}" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource QuickFilterSelectedHoverBackground}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                            <Condition Binding="{Binding IsInverse}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource QuickFilterInverseHoverBackground}" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding HasToolTip}" Value="False">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock x:Name="filterLabel" Text="{Binding DisplayLabel}"
                                       FontSize="13.5"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="Foreground" Value="{DynamicResource PreviewMutedForeground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PreviewForeground}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                                    <Condition Binding="{Binding IsInverse}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource QuickFilterInverseForeground}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsBuiltIn}" Value="True" />
                                                    <Condition Binding="{Binding Label}" Value="&#x2605;" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                                                <Setter Property="FontSize" Value="16" />
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource PreviewFavorite}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid x:Name="monitoringSymbol" Width="28" Height="20"
                                  Visibility="Collapsed" IsHitTestVisible="False">
                                <Path HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Width="14" Height="14"
                                      Data="M 0,0 L 9,0 A 5,5 0 0 1 14,5 L 14,14 Z"
                                      Fill="{DynamicResource RepositoryMonitoringActive}" />
                            </Grid>

                            <Border x:Name="hamburgerButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Padding="4,0,0,0"
                                    Margin="-2,-1,-5,-1"
                                    CornerRadius="0,5,5,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HamburgerButton_MouseDown"
                                    MouseLeftButtonUp="HamburgerButton_MouseUp"
                                    MouseMove="HamburgerButton_MouseMove">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="#40000000" />
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#x2630;"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="#AAFFFFFF"
                                           Margin="0,0,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Popup x:Name="qfEditPopup"
                                   PlacementTarget="{Binding ElementName=qfBorder}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Popup.Style>
                                    <Style TargetType="Popup">
                                        <Setter Property="PopupAnimation" Value="None" />
                                        <Style.Triggers>
                                            <Trigger Property="themes:Appearance.EnableAnimations" Value="True">
                                                <Setter Property="PopupAnimation" Value="Fade" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Popup.Style>
                                <Border Background="{DynamicResource PreviewPrimarySurface}"
                                        BorderBrush="{DynamicResource PreviewMenuBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        MinWidth="220">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Opacity="0.5" ShadowDepth="3" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Label" Foreground="{DynamicResource PreviewSecondaryForeground}" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox x:Name="qfEditLabel"
                                                 FontSize="13"
                                                 Padding="4,3"
                                                 Background="{DynamicResource PreviewBackground}"
                                                 Foreground="{DynamicResource PreviewForeground}"
                                                 BorderBrush="{DynamicResource PreviewMenuBorder}"
                                                 CaretBrush="{DynamicResource PreviewForeground}" />

                                        <TextBlock Text="Tooltip" Foreground="{DynamicResource PreviewSecondaryForeground}" FontSize="11" Margin="0,10,0,3" />
                                        <TextBox x:Name="qfEditToolTip"
                                                 FontSize="13"
                                                 Padding="4,3"
                                                 Background="{DynamicResource PreviewBackground}"
                                                 Foreground="{DynamicResource PreviewForeground}"
                                                 BorderBrush="{DynamicResource PreviewMenuBorder}"
                                                 CaretBrush="{DynamicResource PreviewForeground}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Content="Delete"
                                                    Foreground="{DynamicResource PreviewTagForeground}"
                                                    FontSize="12"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand"
                                                    Click="QuickFilterPopupDelete_Click"
                                                    Style="{DynamicResource MaterialDesignFlatButton}" />
                                            <Button Content="Cancel"
                                                    Foreground="{DynamicResource PreviewSecondaryForeground}"
                                                    FontSize="12"
                                                    Padding="8,3"
                                                    Margin="0,0,6,0"
                                                    Cursor="Hand"
                                                    Click="QuickFilterPopupCancel_Click"
                                                    Style="{DynamicResource MaterialDesignFlatButton}" />
                                            <Button Content="OK"
                                                    Foreground="{DynamicResource PreviewAccent}"
                                                    FontSize="12"
                                                    Padding="8,3"
                                                    Cursor="Hand"
                                                    Click="QuickFilterPopupOk_Click"
                                                    Style="{DynamicResource MaterialDesignFlatButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <Border x:Name="dropPlaceholderRight"
                            Margin="6,0,0,4"
                            Padding="6,2,6,2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource PreviewMenuBorder}"
                            CornerRadius="5"
                            Background="{DynamicResource PreviewTagBackground}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <TextBlock x:Name="dropPlaceholderRightText"
                                   FontFamily="Consolas"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource PreviewMutedForeground}"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <DataTemplate.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsBuiltIn}" Value="True" />
                            <Condition Binding="{Binding Label}" Value="&#x1F441;" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="filterLabel" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="monitoringSymbol" Property="Visibility" Value="Visible" />
                        <Setter TargetName="qfBorder" Property="Padding" Value="0" />
                        <Setter TargetName="qfBorder" Property="CornerRadius" Value="6" />
                        <Setter TargetName="qfBorder" Property="BorderThickness" Value="2" />
                        <Setter TargetName="qfBorder" Property="BorderBrush" Value="{DynamicResource RepositoryMonitoringBorder}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsBuiltIn}" Value="False" />
                            <Condition Binding="{Binding IsMouseOver, ElementName=qfBorder}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="hamburgerButton" Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                    <Trigger SourceName="hamburgerButton" Property="IsMouseOver" Value="True">
                        <Setter TargetName="hamburgerButton" Property="Background" Value="#60000000" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>
</UserControl>