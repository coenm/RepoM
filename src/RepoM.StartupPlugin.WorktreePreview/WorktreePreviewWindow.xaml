<Window x:Class="RepoM.StartupPlugin.WorktreePreview.WorktreePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RepoM.UI.Controls;assembly=RepoM.UI"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:themes="clr-namespace:RepoM.UI.Themes;assembly=RepoM.UI"
        xmlns:viewModels="clr-namespace:RepoM.StartupPlugin.WorktreePreview"
        Title="{DynamicResource WorktreePreviewTitle}"
        Width="460" Height="740" MinWidth="350" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PreviewBackground}" Foreground="{DynamicResource PreviewForeground}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            <ResourceDictionary Source="/RepoM.UI;component/Themes/Theme.Dark.xaml" />
            <ResourceDictionary Source="Themes/RepositoryStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="controls:AcrylicContextMenu" BasedOn="{StaticResource MaterialDesignContextMenu}" />
        <Style TargetType="controls:AcrylicMenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <DockPanel>
                <ComboBox x:Name="ThemeSelector" DockPanel.Dock="Right" Width="125"
                          Margin="8,0,0,0" VerticalAlignment="Center"
                          SelectedValuePath="Tag" SelectedIndex="0"
                          Foreground="{DynamicResource PreviewForeground}"
                          ToolTip="{DynamicResource WorktreePreviewTheme}"
                          AutomationProperties.Name="{DynamicResource WorktreePreviewTheme}">
                    <ComboBoxItem Content="{DynamicResource WorktreePreviewThemeDark}" Tag="{x:Static themes:WorktreePreviewTheme.Dark}" />
                    <ComboBoxItem Content="{DynamicResource WorktreePreviewThemeLight}" Tag="{x:Static themes:WorktreePreviewTheme.Light}" />
                    <ComboBoxItem Content="{DynamicResource WorktreePreviewThemeSystem}" Tag="{x:Static themes:WorktreePreviewTheme.System}" />
                </ComboBox>
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center">
                    <TextBlock Text="PREVIEW" FontSize="10" Foreground="{DynamicResource PreviewAccent}" />
                </Border>
                <TextBlock Text="RepoM" FontSize="24" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="{DynamicResource WorktreePreviewNotice}" Foreground="{DynamicResource PreviewMutedForeground}"
                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
            <CheckBox x:Name="AnimationsToggle" Content="{DynamicResource WorktreePreviewAnimations}"
                      IsChecked="{Binding EnableAnimations, Mode=TwoWay}"
                      Foreground="{DynamicResource PreviewMutedForeground}" FontSize="12"
                      Margin="0,8,0,0" HorizontalAlignment="Left"
                      ToolTip="{DynamicResource WorktreePreviewAnimationsHint}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="{DynamicResource PreviewForeground}" FontSize="15" Padding="6"
                     AutomationProperties.Name="{DynamicResource WorktreePreviewSearch}"
                     ToolTip="{DynamicResource WorktreePreviewSearch}" />
            <TextBlock Text="{DynamicResource WorktreePreviewSearch}"
                       IsHitTestVisible="False" Foreground="{DynamicResource PreviewMutedForeground}" Margin="6,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Filter}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="1" Content="&#x00D7;" Click="ClearFilter_Click"
                    Style="{DynamicResource MaterialDesignFlatButton}" Padding="8,0"
                    Foreground="{DynamicResource PreviewIconForeground}" FontSize="22" MinWidth="30"
                    ToolTip="{DynamicResource WorktreePreviewClear}"
                    AutomationProperties.Name="{DynamicResource WorktreePreviewClear}" />
        </Grid>
        <ListBox x:Name="Repositories" Grid.Row="2" ItemsSource="{Binding VisibleEntries}"
                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PreviewForeground}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="ClipToBounds" Value="True" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <controls:AcrylicContextMenu Background="{DynamicResource PreviewMenuBackground}"
                                                         Foreground="{DynamicResource PreviewForeground}"
                                                         UseFlatPopupStyle="True" HasDropShadow="False"
                                                         BorderBrush="{DynamicResource PreviewMenuBorder}" BorderThickness="1"
                                                         FontSize="13.5" MinWidth="250" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="card" Background="{DynamicResource PreviewPrimarySurface}" CornerRadius="7"
                                        BorderBrush="Transparent" BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWorktree}" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="{DynamicResource PreviewWorktreeSurface}" />
                                        <Setter TargetName="card" Property="CornerRadius" Value="0,6,6,0" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="{DynamicResource PreviewHoverSurface}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="{DynamicResource PreviewSelectedSurface}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="{DynamicResource PreviewFocusedSurface}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorktree}" Value="True">
                            <Setter Property="Margin" Value="28,2,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="entry" Padding="8,10" BorderThickness="0" ToolTip="{Binding Path}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DisplayModeButton" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" Margin="0,2,4,0" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Click="DisplayMode_Click"
                                    IsEnabled="{Binding CanChangeDisplayMode}"
                                    ToolTip="{DynamicResource WorktreePreviewShowDetails}"
                                    AutomationProperties.Name="{DynamicResource WorktreePreviewShowDetails}"
                                    AutomationProperties.HelpText="{DynamicResource WorktreePreviewToggle}">
                                <TextBlock x:Name="Chevron" Text="&#x25B6;" FontSize="12" />
                            </Button>
                            <StackPanel Grid.Column="1">
                                <Border Height="28">
                                <TextBlock x:Name="EntryName" Text="{Binding Name}" FontSize="17"
                                           FontWeight="SemiBold" Foreground="{DynamicResource PreviewAccent}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                </Border>
                                <StackPanel x:Name="EntryDetails"
                                            Visibility="{Binding AreDetailsVisible, Converter={StaticResource PreviewVisibility}}">
                                <TextBlock Text="{Binding Branch}" Foreground="{DynamicResource PreviewSecondaryForeground}"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,7,0,0">
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Text="{Binding Status}" FontFamily="Consolas" FontSize="12" />
                                    </Border>
                                    <Border x:Name="FamilyBadge" Style="{StaticResource Badge}"
                                            Visibility="{Binding HasWorktrees, Converter={StaticResource PreviewVisibility}}">
                                        <TextBlock Foreground="{DynamicResource PreviewBadgeForeground}" FontSize="11">
                                            <Run Text="{Binding WorktreeCount, Mode=OneWay}" /><Run Text=" worktrees" />
                                        </TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Badge}"
                                            Visibility="{Binding IsContextOnly, Converter={StaticResource PreviewVisibility}}">
                                        <TextBlock Text="{DynamicResource WorktreePreviewContext}"
                                                   Foreground="{DynamicResource PreviewBadgeForeground}" FontSize="11" />
                                    </Border>
                                </WrapPanel>
                                <ItemsControl x:Name="Tags" ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource TagChip}"
                                                    ToolTip="{DynamicResource WorktreePreviewTagHint}"
                                                    Click="Tag_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                          VerticalAlignment="Top"
                                          ToolTip="{DynamicResource WorktreePreviewFavorite}"
                                          AutomationProperties.Name="{DynamicResource WorktreePreviewFavorite}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Content" Value="&#x2606;" />
                                        <Setter Property="FontSize" Value="20" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="&#x2605;" />
                                                <Setter Property="Foreground" Value="{DynamicResource PreviewFavorite}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsWorktree}" Value="True">
                            <Setter TargetName="entry" Property="BorderThickness" Value="2,0,0,0" />
                            <Setter TargetName="entry" Property="BorderBrush" Value="{DynamicResource PreviewHierarchy}" />
                            <Setter TargetName="entry" Property="Padding" Value="8,8" />
                            <Setter TargetName="EntryName" Property="FontSize" Value="15" />
                            <Setter TargetName="EntryName" Property="Foreground" Value="{DynamicResource PreviewWorktreeTitle}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayedMode}" Value="{x:Static viewModels:WorktreePreviewDisplayMode.Extended}">
                            <Setter TargetName="Chevron" Property="Text" Value="&#x25BC;" />
                            <Setter TargetName="DisplayModeButton" Property="ToolTip" Value="{DynamicResource WorktreePreviewShowMinimal}" />
                            <Setter TargetName="DisplayModeButton" Property="AutomationProperties.Name" Value="{DynamicResource WorktreePreviewShowMinimal}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DisplayedMode}" Value="{x:Static viewModels:WorktreePreviewDisplayMode.Extended}" />
                                <Condition Binding="{Binding HasWorktrees}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chevron" Property="Text" Value="&#x25E2;" />
                            <Setter TargetName="DisplayModeButton" Property="ToolTip" Value="{DynamicResource WorktreePreviewShowWorktrees}" />
                            <Setter TargetName="DisplayModeButton" Property="AutomationProperties.Name" Value="{DynamicResource WorktreePreviewShowWorktrees}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding AreWorktreesVisible}" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#x25BC;" />
                            <Setter TargetName="DisplayModeButton" Property="ToolTip" Value="{DynamicResource WorktreePreviewShowMinimal}" />
                            <Setter TargetName="DisplayModeButton" Property="AutomationProperties.Name" Value="{DynamicResource WorktreePreviewShowMinimal}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CanChangeDisplayMode}" Value="False">
                            <Setter TargetName="DisplayModeButton" Property="ToolTip" Value="{DynamicResource WorktreePreviewFilterDisplay}" />
                            <Setter TargetName="DisplayModeButton" Property="AutomationProperties.Name" Value="{DynamicResource WorktreePreviewFilterDisplay}" />
                            <Setter TargetName="DisplayModeButton" Property="ToolTipService.ShowOnDisabled" Value="True" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{DynamicResource WorktreePreviewEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PreviewMutedForeground}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource PreviewVisibility}}" />
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{DynamicResource WorktreePreviewFilterHint}" Foreground="{DynamicResource PreviewMutedForeground}"
                       FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource WorktreePreviewMenuHint}" Foreground="{DynamicResource PreviewMutedForeground}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="PreviewFeedback" Foreground="{DynamicResource PreviewFavorite}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding SelectedItem.Path, ElementName=Repositories}"
                       ToolTip="{Binding SelectedItem.Path, ElementName=Repositories}"
                       Foreground="{DynamicResource PreviewAccent}" TextTrimming="CharacterEllipsis" FontSize="11"
                       Margin="0,6,0,0" MinHeight="16" />
        </StackPanel>
    </Grid>
</Window>
