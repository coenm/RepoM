<UserControl x:Class="RepoM.App.Controls.RepositoryComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:RepoM.App.Controls"
             xmlns:git="clr-namespace:RepoM.Api.Git;assembly=RepoM.Api"
             d:DataContext="{d:DesignInstance git:RepositoryViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d" ClipToBounds="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="RepositoryVisibility" />
    </UserControl.Resources>
    <Border Padding="8,10" Background="Transparent" ToolTip="{Binding Path}"
            MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DisplayModeButton" Style="{DynamicResource IconButton}"
                    Width="24" Height="24" Margin="0,2,4,0" HorizontalAlignment="Left"
                    AutomationProperties.Name="{DynamicResource RepositoryToggleDetails}"
                    VerticalAlignment="Top" Click="DisplayMode_Click">
                <Button.ToolTip>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource RepositoryShowDetails}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource RepositoryShowMinimal}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.ToolTip>
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#x25B6;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Text" Value="&#x25BC;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <StackPanel Grid.Column="1">
                <Border Height="28">
                    <TextBlock x:Name="EntryName" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource PreviewAccent}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel x:Name="EntryDetails" Visibility="{Binding IsExpanded, Converter={StaticResource RepositoryVisibility}}">
                    <TextBlock Text="{Binding CurrentBranch}" Foreground="{DynamicResource PreviewSecondaryForeground}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                               Visibility="{Binding IsNotBare, Converter={StaticResource RepositoryVisibility}}" />
                    <WrapPanel Margin="0,7,0,0">
                        <Border Style="{DynamicResource Badge}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource PreviewForeground}" />
                        </Border>
                        <ToggleButton x:Name="MonitoringButton" IsChecked="{Binding IsMonitored, Mode=OneWay}"
                                      Click="MonitoringToggle_Click" Content="&#x1F441;" FontSize="14"
                                      Style="{DynamicResource RepositoryMonitoringButton}"
                                      ToolTip="{DynamicResource RepositoryToggleMonitoring}"
                                      AutomationProperties.Name="{DynamicResource RepositoryToggleMonitoring}">
                        </ToggleButton>
                    </WrapPanel>
                    <ItemsControl x:Name="Tags" ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Tag}" Style="{DynamicResource TagChip}"
                                        ToolTip="{DynamicResource RepositoryFilterTag}"
                                        Command="{Binding DataContext.AddQuickFilterTagCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:RepositoryList}}}"
                                        CommandParameter="{Binding Tag}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            <ToggleButton x:Name="FavoriteButton" Grid.Column="2" VerticalAlignment="Top"
                          Style="{DynamicResource RepositoryFavoriteButton}"
                          IsChecked="{Binding IsFavorite, Mode=OneWay}" Click="FavoriteToggle_Click"
                          ToolTip="{DynamicResource RepositoryToggleFavorite}"
                          AutomationProperties.Name="{DynamicResource RepositoryToggleFavorite}">
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
