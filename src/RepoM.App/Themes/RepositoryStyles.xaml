<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RepoM.App.Controls"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <BooleanToVisibilityConverter x:Key="PreviewVisibility" />
    <Style x:Key="IconButton" TargetType="primitives:ButtonBase">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewIconForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ButtonBase">
                    <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="surface" Property="Background" Value="{DynamicResource PreviewIconHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="surface" Property="Background" Value="{DynamicResource PreviewIconFocus}" />
                            <Setter Property="Foreground" Value="{DynamicResource PreviewIconFocusForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PreviewBadge}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="TagChip" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PreviewTagBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewTagForeground}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,5,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PreviewTagHoverBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource PreviewTagHoverForeground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource PreviewTagHoverBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource PreviewTagHoverForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RepositoryMonitoringButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource RepositoryMonitoringInactive}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Path x:Name="corner" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Width="14" Height="14" Margin="0,2,2,0"
                              Data="M 0,0 L 9,0 A 5,5 0 0 1 14,5 L 14,14 Z"
                              Fill="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="corner" Property="Fill" Value="{DynamicResource RepositoryMonitoringHighlight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource RepositoryMonitoringActive}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RepositoryFavoriteButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Setter Property="Content" Value="&#x2606;" />
        <Setter Property="FontSize" Value="20" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="&#x2605;" />
                <Setter Property="Foreground" Value="{DynamicResource PreviewFavorite}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RepositoryRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="card" Background="{DynamicResource PreviewPrimarySurface}" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="2" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMonitored}" Value="True">
                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource RepositoryMonitoringBorder}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource PreviewHoverSurface}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource PreviewSelectedSurface}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource PreviewFocusedSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
