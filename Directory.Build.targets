<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(UseWPF)' == 'true' and '$(DesignTimeBuild)' == 'true'">
    <!-- A design-time markup pass must not remove BAML used by the regular build. -->
    <IntermediateOutputPath>$(IntermediateOutputPath)design-time\</IntermediateOutputPath>
  </PropertyGroup>
</Project>